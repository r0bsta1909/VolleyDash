# Build- und Distributionsartefakte
build/
# Die entpackten LOEVE-Distributionen (~40 MB) gehoeren nicht ins Repo.
# Die CI laedt sie beim Build von der offiziellen Quelle (12_OPENSOURCE §4).
tools/prebuilt/
*.love
*.exe
*.zip
# Ausnahme: dist/ enthaelt die LIESMICH-Vorlagen und Icon-Quellen, aus denen
# der Build die Pakete zusammensetzt (06_BUILD §5). Es ist Quelle, kein Artefakt.

# Betriebssystem
Thumbs.db
desktop.ini
.DS_Store

# Editor
.vscode/

# Vom Build erzeugt (M1-04). Gehoert in die .love, nicht ins Repo -- sonst
# committet frueher oder spaeter jemand den Build-Hash von gestern.
src/build_info_gen.lua

# Laufzeit- und Testartefakte
tests/replays/tmp/
tests/replays/.last_window
# R-00 ist die Probeaufzeichnung des Werkzeugs, kein Referenzwert.
# Reproduzierbar mit: love . --record-selftest [--fixed-dt]
tests/replays/*/R-00.json
desync.log
.claude/settings.local.json
